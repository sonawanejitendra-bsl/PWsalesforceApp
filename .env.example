# Copy this file to .env. Do not commit .env.
# What each line changes is explained in docs/how-to-change.md.

# Site host only. No path. Example: https://your-site.example.com
PORTAL_URL=https://birlasoftfscdemo-dev-ed.develop.my.site.com

# Path opened by the test. Change this when the start page moves.
PORTAL_PATH=/brokerportal/s/customer-search-portal

# Login values. Locators for the login screen are still placeholders in pages/login.page.ts.
PORTAL_USER=
PORTAL_PASSWORD=

# HEADED=1 shows the browser. Leave unset to run headless.
HEADED=1
