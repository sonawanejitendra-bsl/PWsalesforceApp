{
  "name": "pwsalesforce-app",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright framework and tests for the broker portal onboarding flow.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "onboarding": "playwright test tests/broker-onboarding.spec.ts --workers=1",
